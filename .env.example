# ── Stardome SEAD Explorer Configuration ────────────────────────────────
# SEAD Service URLs — the gateway is TLS-only (even internally), so use https://
# + trust the CA via SEAD_CA_CERT.
SEAD_CORE_URL=https://gateway:30080
EDGE_SERVICE_URL=https://gateway:30080
STORAGE_GATEWAY_URL=https://gateway:30080
VERIFIER_URL=https://gateway:30080

# P2P API (optional — syncs p2p connected peers into the peers table)
# When explorer runs in Docker (sead-network) and p2p uses host networking,
# use the host's LAN IP, e.g. http://192.168.0.102:30089
# P2P_API_URL=http://localhost:30089

# Database
DATABASE_URL=postgresql://explorer:explorer@sead-explorer-db:5432/sead_explorer

# Observer Identity
OBSERVER_ORG_ID=
OBSERVER_NODE_ID=

# Gateway auth — the gateway requires a Bearer token on all endpoints except
# /health. Set to the gateway's SEAD_AUTH_SECRET so the frontier-walk ingestion
# is accepted. Leave empty for gateways with auth disabled.
SEAD_AUTH_SECRET=
# NODE_NAMES maps human-readable node names to SEAD edge_id hex values.
# Format: ``NAME=hex,NAME=hex`` (comma-separated ``name=edge_id_hex`` pairs).
# NODE_NAMES=

# Optional: IPFS
IPFS_API_URL=

# Ingestion
INGESTION_INTERVAL_SECONDS=5

# Logging
LOG_LEVEL=INFO

# SEAD Features (optional, for future use)
SEAD_FEATURES_PEERS_ENDPOINT=
SEAD_FEATURES_FRONTIER_ENDPOINT=
